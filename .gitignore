# kguanoluisa, .gitignore raíz del monorepo BibliaAR (Unity + Flutter), sin nuevas variables, 2026-07-26
# Ignora artefactos de sistema, IDE, builds y secretos en ambos proyectos.

# --- Sistema operativo ---
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
*~

# --- IDEs y editores ---
.vs/
.vscode/
.idea/
.cursor/
*.suo
*.user
*.userosscache
*.sln.docstates
*.swp
*.swo

# --- Secretos y configuración local ---
.env
.env.*
!.env.example
*.pem
*.p12
secrets/
credentials.json

# --- Logs y temporales ---
*.log
logs/
tmp/
temp/
*.tmp
*.bak

